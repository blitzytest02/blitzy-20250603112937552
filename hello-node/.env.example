# =============================================================================
# HELLO-NODE TUTORIAL APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
#
# HOST and PORT are the complete configuration surface of this project: two
# optional variables, each with a default written down here rather than hidden
# in the code (readConfig() in server.js). Change nothing to follow the
# tutorial - 'npm start' with neither set binds localhost:3002.
#
# HOW TO OVERRIDE: put the value in the environment of the command you run.
#
#   PORT=4010 HOST=127.0.0.1 npm start
#   -> Server listening on http://127.0.0.1:4010
#
# There is no 'dotenv' dependency, so copying this file to .env configures
# nothing: readConfig() reads process.env and never a file.
#
# SECURITY NOTE: the two values below are the whole of this template. No
# secret, credential or token appears here, because the server reads none.
#
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server Port Configuration
# Description: TCP port the HTTP server binds, on which GET /hello is served
# Default: 3002
# Accepted input: ask for a port from 1024 to 65535 - the range a process
#   needs no special privilege to bind. That range is documented here, not
#   checked in code: readConfig() computes Number(PORT) || 3002 and hands the
#   result to listen() as it is. An unset, empty, zero or non-numeric PORT is
#   falsy after that coercion and resolves to 3002 silently, so PORT=0 is not a
#   request for an ephemeral port - that is a testing affordance reached only
#   by calling startServer({ port: 0 }) in-process. Anything that coerces to a
#   truthy number is what listen() receives, so a value outside the range is
#   listen()'s to reject: PORT=65536 and PORT=-1 make it throw
#   ERR_SOCKET_BAD_PORT as the server starts.
# Usage: readConfig() in server.js, then server.listen(port, host)
#
# WHY 3002 AND NOT 3000: this repository already allocates 3000 (published on
# the host by the development compose service as "3000:3000",
# infrastructure/docker/docker-compose.yml:86, and a CORS origin of the sibling
# Flask service, src/backend/app.py:271), 3001, 5678 and 8000 (the Flask
# default, src/backend/wsgi.py:106). Nothing here claims 3002. A port another
# process already holds is not shadowed silently: the bind fails and server.js
# reports the failure code - EADDRINUSE - in one line on stderr.
PORT=3002

# Server Host Configuration
# Description: Network interface the HTTP server binds
# Default: localhost, the loopback interface only - reachable from this machine
#   and from nowhere else, the safe default for code run on a laptop
# Accepted input: a hostname or an IP address, passed through to listen()
#   exactly as given - readConfig() computes HOST || localhost and applies no
#   check of its own, so whether a value resolves is the resolver's business
#   and a bind that fails is reported in one line on stderr. HOST=0.0.0.0
#   (IPv4) and HOST=:: (IPv6) therefore do what they say: they bind every
#   interface on the machine, which is what a container deployment needs
#   (src/backend/.env.example:46-49; the Python sibling defaults to 0.0.0.0 for
#   that reason, src/backend/wsgi.py:105). Nothing here rejects such a value,
#   so the exposure is the operator's decision rather than this project's.
# Usage: readConfig() in server.js, then server.listen(port, host)
#
# SECURITY: this value decides who can reach the server, so leave it alone
# unless you intend the exposure.
HOST=localhost
