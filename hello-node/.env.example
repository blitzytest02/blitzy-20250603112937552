# =============================================================================
# hello-node - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and adjust the values if the defaults do not suit
# your machine. These two variables are the ONLY configuration the server
# reads; both are optional, and the server falls back to the defaults below.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# HOST - network interface the HTTP server binds
# -----------------------------------------------------------------------------
# Default: localhost (loopback only, the safe choice for a tutorial).
# Set to 0.0.0.0 to accept traffic on all interfaces (container deployment).
HOST=localhost

# -----------------------------------------------------------------------------
# PORT - TCP port the HTTP server listens on
# -----------------------------------------------------------------------------
# Default: 3002. Chosen because 3000, 3001, 5678 and 8000 are already used by
# the sibling Flask service and its container stack in this repository.
PORT=3002
