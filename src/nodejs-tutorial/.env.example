# =============================================================================
# NODE.JS /HELLO TUTORIAL - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
#
# This file provides a template for environment variable configuration for the
# Node.js tutorial application featuring a single GET /hello endpoint
# (src/nodejs-tutorial). Both variables are optional: each block below names
# its own default, and src/server.js applies that default when the variable is
# absent or blank, so the documented commands work with nothing set at all.
#
# HOW THIS TEMPLATE IS CONSUMED: it is a reference and export template, not a
# file the npm scripts read. `npm start` runs `node src/server.js` and
# `npm run dev` runs `node --watch src/server.js`; neither passes --env-file,
# so neither reads .env or .env.example. Both see only variables already
# exported in the shell. There is no `dotenv` dependency.
#
# SETUP INSTRUCTIONS:
# 1. Read the two blocks below - nothing has to be copied or edited first.
# 2. To change one value for a single run, export it in the shell before the
#    npm script; the Configuration section of README.md gives the exact form.
# 3. To load this whole file instead, use Node's own loader, which is what
#    replaces a `dotenv` dependency here:
#    node --env-file=.env.example src/server.js
# 4. Never commit a .env file. The ignore rules keep every real .env file
#    untracked and exempt secret-free files named .env.example in both tutorials.
#
# SECURITY NOTE: This template contains only example values, no actual secrets
# or credentials - the /hello endpoint requires no authentication on any path
# or method, so none are needed. A value that is a credential belongs in an
# untracked .env file loaded explicitly, never in this committed template.
#
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server Port Configuration
# Description: TCP port the HTTP server binds
# Default: 3000
# Validation: A base-10 integer in 1024-65535 (unprivileged range), enforced
#   in src/server.js before the server binds. The value is trimmed first, and a
#   blank or absent value takes the default; any other value must be base-10
#   digits over its whole length and inside that range, and the resolved number
#   is what reaches listen(). A non-numeric, fractional, signed, zero or
#   out-of-range value is rejected rather than accepted: the process writes one
#   actionable message to stderr and exits with status 1. It does not fall back
#   to the default and it does not bind
# Usage: Read once in src/server.js as process.env.PORT
#
# DEPLOYMENT NOTES:
# - Local development: leave it unset and take the default, which is the port
#   every command and captured transcript on the quick-start path uses - the
#   install, start, verify, test and stop sequence a learner follows with
#   nothing exported. It is not the only port the tutorial shows: the
#   Troubleshooting section of README.md documents PORT overrides for a taken
#   host port and publishes captured transcripts on those ports too
# - Port already taken on this host: export a different PORT for that run. The
#   Troubleshooting section of README.md owns the collision and its fallbacks
# - No hosting platform: this is a local learning service, so nothing external
#   injects this variable the way a deployment platform would
#
# SECURITY: the enforced lower bound keeps the server off the ports that would
# require elevated permission to bind, and rejecting 0 is what stops the kernel
# from handing out an arbitrary port that the startup line would then have to
# guess at
PORT=3000

# Server Host Configuration
# Description: Network interface the HTTP server binds
# Default: 127.0.0.1 (loopback only)
# Validation: A hostname or IP address that resolves to an interface on this
#   machine, enforced in src/server.js the same way PORT is. The value is
#   trimmed first, and a blank or absent value takes the default; a value
#   carrying whitespace or control characters is rejected before the bind, with
#   one actionable message on stderr and exit status 1. An address that is
#   syntactically fine but is not an interface on this machine cannot be
#   rejected up front, so it fails at bind time instead - again one actionable
#   stderr message and exit status 1, never a half-started process.
#   127.0.0.1 is the only value this tutorial documents
# Usage: Read once in src/server.js as process.env.HOST
#
# DEPLOYMENT NOTES:
# - Local development: leave it unset; 127.0.0.1 is the host spelling used by
#   every command, transcript and URL across this tutorial's documentation
# - The startup line is written only once the socket is actually bound, and it
#   reports the address the listener hands back rather than interpolating this
#   variable, so it names the interface and port really being served: a name
#   that resolves somewhere else announces the address it resolved to, and an
#   IPv6 address is announced bracketed
#
# SECURITY: binding the loopback interface keeps this tutorial server
# unreachable from the network, which is deliberate rather than incidental
HOST=127.0.0.1
