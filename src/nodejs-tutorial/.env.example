# =============================================================================
# NODE.JS HELLO WORLD TUTORIAL - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
#
# Environment variable template for the Node.js tutorial application exposing a
# single GET /hello endpoint. It declares every variable the project reads -
# both of them - with the default each one falls back to.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the same directory: cp .env.example .env
# 2. Edit the copy, not this template, changing either value below
# 3. Start the server with 'npm start'
#
# The start script runs `node --env-file-if-exists=.env src/server.js`, so the
# copy is loaded by the runtime itself and no dotenv dependency is needed. A
# missing .env is not an error: the flag writes one informational line to
# stderr - `.env not found. Continuing without it.` - and the server starts on
# the defaults below.
#
# VERSION CONTROL: a real .env is ignored by Git (.gitignore:16 and :22). This
# template is committed deliberately, through the negation at .gitignore:24, so
# it holds only the non-secret defaults shown here - keep credentials, tokens
# and API keys in your own .env, which stays untracked.
#
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server Port Configuration
# Description: TCP port the HTTP listener binds
# Default: 3000, the DEFAULT_PORT constant at src/server.js:5
# Usage: read as env.PORT at src/server.js:10, inside resolveConfig()
# Override for one run without a .env file: PORT=3100 npm start - useful
# because port 3000 is also reserved by this repository's container assets
# (infrastructure/docker/Dockerfile:120, docker-compose.yml:86), while nothing
# here binds 3100
PORT=3000

# Server Host Configuration
# Description: network interface the HTTP listener binds
# Default: localhost, the DEFAULT_HOST constant at src/server.js:6 - loopback
#          only, so the tutorial service is never exposed on the network
#          without an explicit decision to change this value
# Usage: read as env.HOST at src/server.js:11, inside resolveConfig()
HOST=localhost
