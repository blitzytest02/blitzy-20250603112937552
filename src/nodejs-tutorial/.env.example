# Environment template for the Node.js /hello tutorial. Copy it to .env in this
# directory (cp .env.example .env) and edit the copy; npm start loads that copy
# through node --env-file-if-exists=.env, so no dotenv dependency is needed.
#
# A real .env stays untracked (.gitignore:16 and :22) while this template is
# committed through the negation at .gitignore:24, so keep credentials and
# tokens in your own .env and leave only non-secret defaults here.

# Server Port Configuration
# Description: TCP port the HTTP listener binds
# Default: 3000, the DEFAULT_PORT constant at src/server.js:5
# Accepts: a whole decimal number from 1 to 65535. Anything else - 3000junk,
#          1e3, a negative value, an unassignable number - is reported on
#          stderr and replaced by the default, never bound
# Usage: read as env.PORT at src/server.js:10, inside resolveConfig()
# Override for one run without a .env file: PORT=3100 npm start
PORT=3000

# Server Host Configuration
# Description: network interface the HTTP listener binds
# Default: localhost, the DEFAULT_HOST constant at src/server.js:6 - loopback
#          only, so nothing beyond this machine can reach the service
# Accepts: an IP literal (127.0.0.1, ::1, or the wildcards 0.0.0.0 and ::) or
#          a DNS name. A numeric alias such as 0, 0x0 or 0000 is refused and
#          replaced by the default rather than widened to 0.0.0.0, which is
#          what the name resolver would otherwise make of it
# WARNING: 0.0.0.0 and :: publish this unauthenticated tutorial service to
#          every host your machine and network firewall admit. Read the
#          exposure warning in README.md's Configuration section before you
#          set either, use them only on a network you trust, and keep
#          localhost for local learning
# Usage: read as env.HOST at src/server.js:11, inside resolveConfig()
HOST=localhost
