# Environment template for the Node.js Hello World tutorial.
# Copy this file to .env (cp .env.example .env) and edit the copy.
# The start script loads it with `node --env-file-if-exists=.env`, so a missing
# .env is not an error - the defaults below apply instead.

# TCP port the HTTP listener binds. Default: 3000
# Read by src/server.js (resolveConfig), default constant DEFAULT_PORT.
PORT=3000

# Network interface the HTTP listener binds. Default: localhost
# Read by src/server.js (resolveConfig), default constant DEFAULT_HOST.
HOST=localhost
