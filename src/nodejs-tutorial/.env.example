# =============================================================================
# Environment template - Node.js /hello tutorial (src/nodejs-tutorial)
# =============================================================================
# Reference and export template. Copy a value onto a command line, or load the
# whole file with Node's built-in loader:
#
#   PORT=3001 npm start
#   node --env-file=.env.example src/server.js
#
# The `start` and `dev` scripts do NOT pass --env-file, so they see only
# variables already exported in the shell. There is no `dotenv` dependency.
# =============================================================================

# Server Port Configuration
# Description: TCP port the HTTP server binds
# Default: 3000
# Validation: Integer 1024-65535 (unprivileged range)
# Usage: Read once in src/server.js as process.env.PORT
#
# NOTE: host port 3000 is also published by the Flask development container
# (infrastructure/docker/docker-compose.yml:86). If that container is running,
# override with PORT=3001, then PORT=3100.
PORT=3000

# Server Host Configuration
# Description: Network interface the HTTP server binds
# Default: 127.0.0.1 (loopback only)
# Validation: Valid hostname, IP address, or 0.0.0.0 for all interfaces
# Usage: Read once in src/server.js as process.env.HOST
#
# SECURITY: the loopback default keeps this tutorial server off the network.
# Use 0.0.0.0 only when you deliberately want it reachable.
HOST=127.0.0.1
