{
  "name": "nodejs-hello-world-tutorial",
  "version": "1.0.0",
  "description": "Node.js tutorial project exposing a single GET /hello endpoint that returns \"Hello world\".",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
