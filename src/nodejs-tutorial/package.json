    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --runInBand --coverage"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.2.2"
  },
